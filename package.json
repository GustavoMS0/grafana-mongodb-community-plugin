{
  "name": "meln5674-mongodb-community",
  "version": "2.0.0",
  "description": "Modern MongoDB Datasource Plugin for Grafana 11 & 12 (MongoDB 6/7/8)",
  "scripts": {
    "backend": "go vet ./pkg/... && mage -v",
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "clean": "rm -rf meln5674-mongodb-community dist/",
    "deps": "npm install --legacy-peer-deps && go mod download",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "integration-test": "ginkgo run --race --trace -v ./e2e/...",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx ./src && go vet ./pkg/...",
    "lint:fix": "npm run lint -- --fix",
    "plugin": "rm -f meln5674-mongodb-community.zip; zip -r meln5674-mongodb-community.zip dist/ CHANGELOG.md",
    "really-clean": "rm -rf meln5674-mongodb-community dist/ node_modules/",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "npm run dev",
    "test": "jest --watch --onlyChanged",
    "test-backend": "go test -v -race ./pkg/...",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Gustavo Martins (Fork of Andrew Melnick)",
  "license": "AGPL-3.0",
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@grafana/data": "^11.5.0",
    "@grafana/runtime": "^11.5.0",
    "@grafana/ui": "^11.5.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@grafana/eslint-config": "^6.0.0",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@swc/core": "^1.4.2",
    "@swc/helpers": "^0.5.5",
    "@swc/jest": "^0.2.36",
    "@swc/register": "^0.1.10",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-webpack-plugin": "^4.1.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "glob": "^10.3.10",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "resolutions": {
    "rxjs": "^7.8.1"
  },
  "overrides": {
    "rxjs": "^7.8.1"
  },
  "engines": {
    "node": ">=18"
  }
}
